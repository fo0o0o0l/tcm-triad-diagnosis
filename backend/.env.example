# 后端环境变量模板（《开发任务文档》§2.4）
# 复制为 .env 后按需修改；真实 .env 不入库。

APP_ENV=dev
APP_PORT=8000
API_PREFIX=/api/v1
DEBUG=true

# CORS（前端开发服务器地址，逗号分隔的 JSON 数组形式）
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DATABASE_URL=postgresql+asyncpg://tcm:tcm_dev_pwd@localhost:5432/tcm_triad
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=please-change-me
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=14
PASSWORD_HASH_ROUNDS=12

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=tcm-private
S3_SIGNED_URL_EXPIRE_SECONDS=900

ALGO_BASE_URL=http://localhost:8100
# 调算法服务（LLM）的 httpx 超时；应大于算法服务内 LLM_TIMEOUT_SECONDS，确保先干净失败再降级
ALGO_TIMEOUT_SECONDS=90

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@tcm-triad.local

DEFAULT_CONFIDENCE_THRESHOLD=0.7

# 本地未启动 PG/Redis/MinIO 时保持 false，/health 将依赖项标记为 skipped
HEALTH_CHECK_DEPENDENCIES=false

# 日志落盘（终端同时保留输出）；文件按 LOG_MAX_BYTES 滚动，保留 LOG_BACKUP_COUNT 份
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE=backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
