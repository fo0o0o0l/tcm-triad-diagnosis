# 三诊合一 算法服务配置模板
# 复制为同目录下的 .env 后填入真实值；.env 已被仓库根 .gitignore 忽略，不会入库。

# 阿里云百炼（DashScope）API Key：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容端点（默认北京地域；key 与地域绑定，跨地域会 401）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型：qwen-plus（均衡，默认）/ qwen-max（更强）/ qwen-turbo（更快更省）
LLM_MODEL=qwen-plus

# 视觉模型（舌象 / 面象特征识别）：qwen3-vl-plus（默认）/ qwen-vl-max（需在百炼开通）
VL_MODEL=qwen3-vl-plus

# 单次大模型调用超时（秒）；应小于后端 ALGO_TIMEOUT_SECONDS，确保先干净失败再降级
LLM_TIMEOUT_SECONDS=60
